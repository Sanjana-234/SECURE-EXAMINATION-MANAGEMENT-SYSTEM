SEMS_DOMAIN=exams.example.edu
# REQUIRED in production, 32+ random chars (openssl rand -base64 48). Also encrypts MFA seeds: losing it disables MFA logins.
SEMS_SECRET=
# First start only (empty database), then delete these two lines:
SEMS_BOOTSTRAP_ADMIN_EMAIL=
SEMS_BOOTSTRAP_ADMIN_PASSWORD=
# 1 = admins cannot use the API until they enable two-factor
SEMS_REQUIRE_ADMIN_MFA=1
